{
  "name": "whatsapp-veille",
  "version": "1.0.0",
  "private": true,
  "description": "Assistant de veille emploi par WhatsApp : analyse de CV, collecte d'offres, scoring IA et digest quotidien.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --experimental-sqlite src/index.ts",
    "start": "tsx --experimental-sqlite src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:build": "node --experimental-sqlite dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "verifier": "tsx --experimental-sqlite tools/verification.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "mammoth": "^1.8.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "openai": "^4.68.0",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
