# =====================================================================
#  whatsapp-veille — variables d'environnement
#  Copier ce fichier en .env puis renseigner les valeurs.
# =====================================================================

# --- WhatsApp ---------------------------------------------------------
# Numero WhatsApp du proprietaire (celui sur lequel le bot est appaire).
# N'est PAS une restriction d'acces : le bot est multi-utilisateur (section
# 6.9), n'importe qui ecrivant a ce numero obtient son propre profil et sa
# propre planification. Ce numero identifie seulement l'appairage et sert de
# reference pour l'interface web locale (toujours reservee au proprietaire).
# Format : indicatif pays + numero, sans "+", suivi de "@c.us".
# Exemple pour le Burkina Faso : 22670000000@c.us
NUMERO_AUTORISE=226XXXXXXXX@c.us

# --- DeepSeek ---------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODELE=deepseek-v4-flash
# Base URL de l'API (compatible SDK openai). A ne changer qu'en cas
# d'evolution documentee cote DeepSeek.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Tarifs utilises UNIQUEMENT pour l'estimation de cout affichee par !stats
# (USD par million de tokens). Verifier la grille en vigueur sur la
# documentation officielle : une tarification heures pleines / heures
# creuses est entree en vigueur le 16 aout 2026.
PRIX_ENTREE_USD_PAR_M=0.28
PRIX_SORTIE_USD_PAR_M=0.42

# --- Sources ----------------------------------------------------------
# ReliefWeb : l'API v1 est decommissionnee, le connecteur utilise la v2.
# ATTENTION : la v2 exige un `appname` APPROUVE par ReliefWeb, sinon toute
# requete renvoie HTTP 403. La demande est gratuite :
# https://apidoc.reliefweb.int/parameters#appname
# Laisser vide desactive proprement la source.
# ReliefWeb : laisser VIDE tant que tu n'as pas un appname APPROUVE
# (sinon HTTP 403 a chaque cycle). Demande gratuite :
# https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Code pays Adzuna (fr, gb, us, de, ...). Determine le marche interroge.
ADZUNA_PAYS=fr

# Jooble (agregateur) : cle gratuite https://jooble.org/api/about
JOOBLE_CLE=
# Careerjet (agregateur) : affid partenaire https://www.careerjet.com/partners
CAREERJET_AFFID=
CAREERJET_LOCALE=fr_FR

# --- Parametres de veille --------------------------------------------
# NOTE : la frequence et l'heure NE SONT PAS definies ici.
# Elles sont choisies par l'utilisateur via WhatsApp (§ 6.5)
# et stockees en base. Les valeurs ci-dessous ne servent qu'au
# premier amorcage, avant tout choix explicite.
FREQUENCE_DEFAUT=quotidien
HEURE_DEFAUT=08:00
FUSEAU=Africa/Ouagadougou
MAX_OFFRES_DIGEST=8
# Score minimum pour afficher une offre (sous ce seuil = masquee).
SEUIL_SCORE_DEFAUT=50
MAX_ANCIENNETE_JOURS=14
LIEUX_ACCEPTES=Burkina Faso,Ouagadougou,Teletravail,Remote

# Appairage par code a 8 caracteres au lieu du QR : utile si le terminal
# rend le QR illisible. Le numero utilise est celui de NUMERO_AUTORISE.
APPAIRAGE_PAR_CODE=false

# Desactive la verif TLS WhatsApp (true recommande sous Windows si un
# antivirus intercepte le HTTPS : sinon "Impossible de connecter l appareil").
# Sur Render / Linux : false.
WHATSAPP_TLS_INSECURE=true

# --- Divers -----------------------------------------------------------
LOG_LEVEL=info

# Panneau d'administration : http://127.0.0.1:PORT en local.
# Sur Render : WEB_BIND=0.0.0.0 + ADMIN_USER / ADMIN_PASSWORD obligatoires.
PORT=3000
WEB_BIND=127.0.0.1
ADMIN_USER=
ADMIN_PASSWORD=

# Disque persistant (Render Disk). Vide = ./data a la racine du projet.
# Sur Render : DATA_DIR=/var/data
DATA_DIR=
